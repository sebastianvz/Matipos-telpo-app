<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.activity.DeviceSettingsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:textColor="@color/colorAccent"
            android:id="@+id/textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Devices Settings"
            android:textAlignment="center"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"
            android:textSize="30dp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchFaceRecognition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Face Recognition"/>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchQrReader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="QR Reader"/>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchNfcReader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="NFC Reader"/>


    </LinearLayout>

    <Button
        android:layout_marginBottom="20dp"
        android:layout_gravity="center|bottom"
        android:id="@+id/btnUpdate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="UPDATE"
        android:textSize="28sp"
        android:textStyle="bold"/>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|left"
        android:layout_margin="22dp"
        android:src="@drawable/baseline_arrow_back_24" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>